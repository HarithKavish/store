<?xml version="1.0" encoding="utf-8"?>
<!-- A card whose app has an update: the same card, edged in the update blue. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="#668AB4F8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
